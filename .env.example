FLOWSIGHT_ENV=development

# PostgreSQL — misma app, distinto destino (solo cambia esta URL).
# Local (desarrollo aislado / tests / CI):
FLOWSIGHT_DATABASE_URL=postgresql+psycopg://flowsight:flowsight@127.0.0.1:5432/flowsight
# Integración / demo (password por canal seguro del equipo; ver docs/acceso-compartido-azure.md):
# FLOWSIGHT_DATABASE_URL=postgresql+psycopg://flowsight:PASSWORD@ia-aplicada-flowsight.postgres.database.azure.com:5432/postgres?sslmode=require

FLOWSIGHT_API_HOST=127.0.0.1
FLOWSIGHT_API_PORT=8000
FLOWSIGHT_WORKER_ID=worker-local
FLOWSIGHT_PREVIEW_MAX_FPS=5

# Videos locales (specs/004). Opcionales: la API y el worker arrancan sin ellas,
# pero registrar o recargar un video responde 503 hasta que estén configuradas.
# Carpeta donde se copian los videos registrados; ruta absoluta, fuera del repo.
# Ejemplo Windows: C:\FlowSight\videos · Linux: /home/<usuario>/flowsight-videos
FLOWSIGHT_VIDEOS_DIR=
# Identificador de este equipo: minúsculas, dígitos y guiones, 3–40 caracteres,
# empieza con letra o dígito (p. ej. equipo-03). NO uses tu nombre ni tu usuario
# del sistema: se guarda con cada video registrado y lo ve todo el equipo.
# Un valor inválido no impide arrancar; se trata como no configurado.
FLOWSIGHT_MACHINE_ID=

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000

# Azure AI Foundry — script validate-azure-model / futuro chat (Feature #16).
# API key por canal seguro. Valores no secretos: docs/acceso-compartido-azure.md
# La API y el worker NO exigen estas variables para arrancar.
FLOWSIGHT_AZURE_AI_ENDPOINT=https://ia-aplicada-flowsight-resource.services.ai.azure.com/api/projects/ia-aplicada-flowsight
FLOWSIGHT_AZURE_AI_API_KEY=
FLOWSIGHT_AZURE_AI_DEPLOYMENT=gpt-5-mini
FLOWSIGHT_AZURE_AI_API_VERSION=v1
FLOWSIGHT_AZURE_AI_REGION=brazilsouth
FLOWSIGHT_AZURE_AI_MODEL=gpt-5-mini
FLOWSIGHT_AZURE_AI_MODEL_NOTES=Modelo habilitado en Foundry del equipo
FLOWSIGHT_AZURE_OPENAI_ENDPOINT=https://ia-aplicada-flowsight-resource.openai.azure.com/openai/v1
FLOWSIGHT_AZURE_AI_RESPONSES_URL=
